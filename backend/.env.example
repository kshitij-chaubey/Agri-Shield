# ==============================================================================
# AgriShield AI - Environment Configuration Example
# ==============================================================================

# Server Port
PORT=8000

# AI Reasoning Engine (Optional: System runs domain agronomist heuristics if key is not provided)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Twilio Telephony Settings (Optional: Set MOCK_TELEPHONY=True or leave blank for rich simulated mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Hackathon Judge / Developer Test Phone (Used to receive real SMS & IVR demo calls when Twilio keys are supplied)
TEST_RECEIVER_PHONE=+919861012345

# Mock Telephony Toggle (Set to False when real Twilio credentials are provided)
MOCK_TELEPHONY=True

# Public Base URL (Used for Twilio webhooks and audio streams during real calls, e.g., ngrok tunnel or localhost)
PUBLIC_BASE_URL=http://localhost:8000
